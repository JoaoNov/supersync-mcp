# Copy to .env. Do not put the SuperSync token or the MCP access key here.

# Address and port published on the Docker host. 127.0.0.1 accepts connections
# from this machine only. Set MCP_BIND_ADDRESS to a private interface address
# when clients on that network should connect to the port directly.
MCP_BIND_ADDRESS=127.0.0.1
MCP_HOST_PORT=1901

# Address and port the Node process binds inside the container.
# Leave LISTEN_HOST at 0.0.0.0 when Docker publishes the port.
LISTEN_HOST=0.0.0.0
PORT=1901

# Host header values accepted by DNS-rebinding protection.
# Loopback is always added. Add every name or address clients send as Host.
ALLOWED_HOSTS=127.0.0.1,localhost

# Writes stay off until this is true. Read tools are always available.
MCP_ALLOW_WRITES=false

# Calendar timezone for "today" and due days. Default Europe/Brussels.
TZ=Europe/Brussels

# Fallback hour for time_by_day and worklog_report when the account has no
# start-of-next-day setting. 4 means the working day ends at 04:00.
# An account startOfNextDayTime wins, and stored day keys are not moved.
DAY_START_HOUR=4

# Append-only write log inside the persisted changes volume.
# Entries store tool, request id, sequences, and entity before/after state.
# They do not store the access key or the SuperSync token.
CHANGE_LOG_PATH=data/changes/changes.jsonl
CHANGE_LOG_MAX_BYTES=1048576

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

LOCAL_UID=1000
LOCAL_GID=1000
